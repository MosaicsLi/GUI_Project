# .env.example - Example of the settings file
#
# How to use:
#   1. Copy this file and rename the copy to ".env"
#   2. Fill in your own values in ".env"
#   3. Never commit ".env" (it is listed in .gitignore)
#
# Format: one setting per line, NAME=value, no spaces around "=".
# Lines that start with "#" are comments.

# ----- HTTP (no SDK, OpenAI format, for self-hosted LLM) -----

# LM Studio
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=your-model-name
LMSTUDIO_API_KEY=

# Ollama
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=your-model-name
OLLAMA_API_KEY=

# ----- SDK (official SDK of each company) -----

# Google
GEMINI_API_KEY=your-google-api-key
GEMINI_MODEL=gemini-2.5-flash

# Claude
ANTHROPIC_API_KEY=your-anthropic-api-key
CLAUDE_MODEL=claude-opus-5-5

# OpenAI
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini

# ----- Common settings -----

# Seconds to wait for a reply
LLM_TIMEOUT=60
# How many times to try when the connection fails
LLM_MAX_RETRIES=2
